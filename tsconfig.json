{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src", "tests"],
  "exclude": ["tests/fixtures"]
}
