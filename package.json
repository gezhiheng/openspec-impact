{
  "name": "openspec-impact",
  "version": "0.4.1",
  "description": "Deterministic OpenSpec candidate-code-scope CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gezhiheng/openspec-impact.git"
  },
  "bin": {
    "openspec-impact": "dist/src/cli.js",
    "osi": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "templates/",
    "README.md",
    "docs/product-overview.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "fmt": "oxfmt && oxlint --fix",
    "fmt:check": "oxfmt --check && oxlint",
    "test": "tsc && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
